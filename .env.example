# Database Configuration
DATABASE_URL=postgresql://dxtx_user:dxtx_password@localhost:5432/dxtx_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your-secret-key-change-this-in-production

# Telnyx Configuration
TELNYX_API_KEY=your-telnyx-api-key
TELNYX_PUBLIC_KEY=your-telnyx-public-key
TELNYX_APP_ID=your-telnyx-app-id
TELNYX_PHONE_NUMBER=+1234567890

# TwinMind Configuration (Real-time Transcription)
TWINMIND_API_KEY=your-twinmind-api-key
TWINMIND_API_URL=https://api.twinmind.ai/v1

# Deepgram Configuration (Fallback Transcription & TTS)
DEEPGRAM_API_KEY=your-deepgram-api-key

# ElevenLabs Configuration (Primary TTS)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-default-voice-id

# OpenAI Configuration (LLM for dialogue)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-this

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Security & HIPAA Compliance
ENCRYPTION_KEY=your-encryption-key-32-chars-min
AUDIT_LOG_ENABLED=true
DATA_RETENTION_DAYS=2555

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis (for session management and caching)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=INFO
SENTRY_DSN=your-sentry-dsn-optional
